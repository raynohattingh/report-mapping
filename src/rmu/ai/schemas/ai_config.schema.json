{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rmu/ai-config.schema.json",
  "title": "ai.yaml — assistance modes, local models, consent registry (R6)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "default_mode": {
      "enum": ["none", "local", "external"],
      "default": "local"
    },
    "local": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "embedding_model": {"type": "string", "default": "BAAI/bge-small-en-v1.5"},
        "llm_model": {"type": "string", "default": "qwen3:4b"},
        "vision_model": {"type": "string", "default": "qwen2.5vl:7b"},
        "ollama_host": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "MUST resolve to loopback; enforced in code beyond this schema (FR-002)."
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600, "default": 120}
      }
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {"enum": ["anthropic"], "default": "anthropic"},
        "model": {"type": "string"}
      }
    },
    "consent": {
      "type": "array",
      "description": "Owner-recorded per-client external-API consent (FR-004). Edited ONLY via `rmu ai consent grant|revoke`.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["client", "granted_by", "granted_at"],
        "properties": {
          "client": {"type": "string", "minLength": 1, "maxLength": 80},
          "granted_by": {"type": "string", "minLength": 1},
          "granted_at": {"type": "string", "format": "date"},
          "note": {"type": "string", "maxLength": 300}
        }
      }
    }
  }
}
